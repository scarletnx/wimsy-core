{{/* SWS's theme picker at the top of every page (docs/THEMES.md): plain links to the Tracer site's nginx, which keeps
the pick in a cookie of all of scarletnx.dev and sends the reader back to this page; the pick in effect filled. */}}
{{- $t := "sepia" -}}
{{- $m := "auto" -}}
{{- with .Context -}}
{{- $c := .GetSiteCookie "sws_theme" -}}
{{- if or (eq $c "wimsy") (eq $c "fuddles") (eq $c "default") -}}{{- $t = $c -}}{{- end -}}
{{- $c = .GetSiteCookie "sws_mode" -}}
{{- if or (eq $c "light") (eq $c "dark") -}}{{- $m = $c -}}{{- end -}}
{{- end }}
<nav class="sws" aria-label="Theme"><span>Theme</span>
<a href="https://issues.scarletnx.dev/sws/sepia" referrerpolicy="no-referrer-when-downgrade"{{if eq $t "sepia"}} aria-current="true"{{end}}>Sepia</a>
<a href="https://issues.scarletnx.dev/sws/wimsy" referrerpolicy="no-referrer-when-downgrade"{{if eq $t "wimsy"}} aria-current="true"{{end}}>Wimsy</a>
<a href="https://issues.scarletnx.dev/sws/fuddles" referrerpolicy="no-referrer-when-downgrade"{{if eq $t "fuddles"}} aria-current="true"{{end}}>Fuddles</a>
<a href="https://issues.scarletnx.dev/sws/default" referrerpolicy="no-referrer-when-downgrade"{{if eq $t "default"}} aria-current="true"{{end}}>Default</a>
<span>Mode</span>
<a href="https://issues.scarletnx.dev/sws/auto" referrerpolicy="no-referrer-when-downgrade"{{if and (ne $t "default") (eq $m "auto")}} aria-current="true"{{end}}>Auto</a>
<a href="https://issues.scarletnx.dev/sws/light" referrerpolicy="no-referrer-when-downgrade"{{if and (ne $t "default") (eq $m "light")}} aria-current="true"{{end}}>Light</a>
<a href="https://issues.scarletnx.dev/sws/dark" referrerpolicy="no-referrer-when-downgrade"{{if or (eq $t "default") (eq $m "dark")}} aria-current="true"{{end}}>Dark</a>
</nav>
