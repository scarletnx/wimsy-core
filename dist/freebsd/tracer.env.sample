TRACER_TOKEN=
TRACER_URL=https://
# Each optional setting a line of its own once it has a value (an empty one stops the service):
# TRACER_CHANNELS=id,id     the channels it answers in, and their threads and forum posts (none without it: it takes
#                           no report; Developer Mode, Copy Channel ID)
# TRACER_ADMINS=id,id       who deletes any report beside the server's administrators (Copy User ID)
# TRACER_TITLES=file        the games' names, made here by scripts/make-titles.py --out file (none without it)
# TRACER_ISSUES_REPO=OWNER/NAME  the repository an administrator's approval (a reaction) files a report into (none
#                                without it: no issue)
# TRACER_ISSUES_TOKEN=...   a fine-grained token of that repository alone, Issues read and write
# TRACER_ISSUES_EMOJI=...   the approval's emoji (the check mark without it)
# TRACER_ISSUES_LABELS=a,b  the labels each issue gets (none without it)
