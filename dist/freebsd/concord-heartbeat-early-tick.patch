From a836478077c9657259739729ae29a3c904cf5ace Mon Sep 17 00:00:00 2001
From: AO55 <AO55@reden-emu.dev>
Date: Thu, 5 Nov 2026 10:04:26 -0300
Subject: [PATCH] fix(gateway): a heartbeat tick before the pulse is due judges
 nothing

A zombie leaves the heartbeat timer firing every millisecond, its last pulse an interval old, and the timer outlives the reconnection. READY on the next connection sends a pulse and the next millisecond's tick found it unanswered, so every zombie reconnected twice, the second time a millisecond after READY, while the guilds' frames were still arriving. A pulse the server asks for met the same tick, due to the one before. A tick now judges and pulses only once the last pulse is due, and waits for that otherwise; the tests that forced a tick right after a pulse put the pulse an interval back.

Signed-off-by: AO55 <AO55@reden-emu.dev>
---
 src/discord-gateway_dispatch.c |  8 +++++-
 test/unit-gateway-lifecycle.c  | 47 +++++++++++++++++++++++++++++++---
 2 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/src/discord-gateway_dispatch.c b/src/discord-gateway_dispatch.c
index 9dad71a..90f0925 100644
--- a/src/discord-gateway_dispatch.c
+++ b/src/discord-gateway_dispatch.c
@@ -274,9 +274,15 @@ _discord_on_heartbeat_timeout(struct discord *client,
     (void)client;
     struct discord_gateway *gw = timer->data;
 
+    /* a tick before the last pulse is due judges nothing: one left firing
+     * every millisecond by the connection before, or due to a pulse READY,
+     * RESUMED or the server's request has sent since, would take that pulse
+     * for unanswered before its ACK had time to come */
     if (CCORD_OK == discord_gateway_perform(gw)
         && ~gw->session->status & DISCORD_SESSION_SHUTDOWN
-        && gw->session->is_ready)
+        && gw->session->is_ready
+        && gw->timer->now
+               >= gw->timer->hbeat_last + (u64unix_ms)gw->timer->hbeat_interval)
     {
         /* zombie detection belongs to the periodic path only: a missed
          * ACK since the previous pulse means the connection is dead */
diff --git a/test/unit-gateway-lifecycle.c b/test/unit-gateway-lifecycle.c
index 49194d7..a12d7f9 100644
--- a/test/unit-gateway-lifecycle.c
+++ b/test/unit-gateway-lifecycle.c
@@ -165,6 +165,7 @@ heartbeat_cadence_refire(void)
     ASSERT_EQ(0, tg_handshake(&tg));
 
     tg_deliver(&tg, "{\"t\":null,\"s\":null,\"op\":11,\"d\":null}"); /* ACK */
+    tg.gw->timer->hbeat_last = 1; /* READY's pulse an interval old: due */
     force_heartbeat_timer(&tg);
 
     ASSERT_EQ((size_t)1, mockws_sent_count(tg.ws));
@@ -189,10 +190,11 @@ zombie_connection_reconnects(void)
     ASSERT_EQ(0, tg_connect(&tg));
     ASSERT_EQ(0, tg_handshake(&tg));
 
-    /* READY's heartbeat was never ACK'd; the next cadence tick must
-     * treat the connection as zombie and reconnect with a fresh
-     * session (close 1000, resumability not retained) */
+    /* READY's heartbeat was never ACK'd; the next cadence tick, an
+     * interval on, must treat the connection as zombie and reconnect
+     * with a fresh session (close 1000, resumability not retained) */
     ASSERT_EQ(false, tg.gw->timer->hbeat_acknowledged);
+    tg.gw->timer->hbeat_last = 1;
     force_heartbeat_timer(&tg);
 
     ASSERT_EQ((size_t)0, mockws_sent_count(tg.ws));
@@ -235,6 +237,7 @@ failed_heartbeat_send_reconnects(void)
     ASSERT(discord_internal_timer_ctl(tg.client, &t));
     ASSERT(t.interval > tg.gw->timer->hbeat_interval / 2);
 
+    tg.gw->timer->hbeat_last = 1; /* that tick, an interval on */
     force_heartbeat_timer(&tg);
     ASSERT_EQ(1, mockws_close_requested(tg.ws, &code));
     ASSERT_EQ(WS_CLOSE_REASON_NORMAL, code);
@@ -244,6 +247,43 @@ failed_heartbeat_send_reconnects(void)
     PASS();
 }
 
+TEST
+early_tick_judges_nothing(void)
+{
+    struct test_gateway tg;
+    struct discord_timer t = { 0 };
+
+    ASSERT_EQ(0, tg_boot(&tg));
+    ASSERT_EQ(0, tg_connect(&tg));
+    ASSERT_EQ(0, tg_handshake(&tg));
+
+    /* READY's pulse just sent and the timer firing now, as the one a zombie
+     * left firing every millisecond does: its ACK has had no time to come,
+     * so the tick neither reconnects nor pulses, and waits for the pulse to
+     * be due */
+    ASSERT_EQ(false, tg.gw->timer->hbeat_acknowledged);
+    force_heartbeat_timer(&tg);
+    ASSERT_EQ((size_t)0, mockws_sent_count(tg.ws));
+    ASSERT_EQ(0, mockws_close_requested(tg.ws, NULL));
+    ASSERT(!(tg.gw->session->status & DISCORD_SESSION_SHUTDOWN));
+    t.id = tg.gw->timer->hbeat_timer;
+    t.flags = DISCORD_TIMER_GET;
+    ASSERT(discord_internal_timer_ctl(tg.client, &t));
+    ASSERT(t.interval > tg.gw->timer->hbeat_interval / 2);
+
+    /* ACK'd, then a pulse the server asks for: the tick due to READY's comes
+     * before this one's ACK could, and judges nothing either */
+    tg_deliver(&tg, "{\"t\":null,\"s\":null,\"op\":11,\"d\":null}");
+    tg_deliver(&tg, "{\"t\":null,\"s\":null,\"op\":1,\"d\":null}");
+    mockws_drain_sent(tg.ws);
+    force_heartbeat_timer(&tg);
+    ASSERT_EQ((size_t)0, mockws_sent_count(tg.ws));
+    ASSERT_EQ(0, mockws_close_requested(tg.ws, NULL));
+
+    tg_cleanup(&tg);
+    PASS();
+}
+
 TEST
 server_heartbeat_request_gets_reply(void)
 {
@@ -284,6 +324,7 @@ SUITE(gateway_lifecycle)
     RUN_TEST(heartbeat_cadence_refire);
     RUN_TEST(zombie_connection_reconnects);
     RUN_TEST(failed_heartbeat_send_reconnects);
+    RUN_TEST(early_tick_judges_nothing);
     RUN_TEST(server_heartbeat_request_gets_reply);
 }
 
